# ==============================================================================
# KOPYKAT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit your real .env file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED CORE SECURITY & AUTHENTICATION (MUST CONFIGURE IN PRODUCTION)
# ------------------------------------------------------------------------------

# Secret key used for signing JWT authentication tokens.
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Fernet symmetric encryption key for stored marketplace API credentials & BYOK keys.
# Generate a 32-byte base64 Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=replace_with_a_base64_fernet_key

# Master admin secret header (X-Admin-Secret) for inspecting revenue & health.
ADMIN_SECRET=replace_with_a_secure_admin_passphrase


# ------------------------------------------------------------------------------
# 2. REQUIRED DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

# PostgreSQL connection URI (Neon.tech, Supabase, or AWS RDS).
# In local development without Postgres, falls back to SQLite file database automatically.
# Example: postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/kopykat?sslmode=require
DATABASE_URL=sqlite:///./kopykat.db


# ------------------------------------------------------------------------------
# 3. AI ENGINE CONFIGURATION (GOOGLE GEMINI)
# ------------------------------------------------------------------------------

# Google AI Studio API Key for Gemini content & vision generation.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Default Gemini model name
# Defaults to: gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest


# ------------------------------------------------------------------------------
# 4. STRIPE BILLING CONFIGURATION
# ------------------------------------------------------------------------------

# Stripe Secret API Key (begins with sk_live_... in prod or sk_test_... in dev)
STRIPE_SECRET_KEY=sk_test_51...

# Stripe Webhook Signing Secret (begins with whsec_...)
# Obtain from Stripe Dashboard -> Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for Subscription Tiers
# Create recurring monthly prices in Stripe Dashboard:
STRIPE_PRICE_BOUTIQUE=price_boutique_179_49
STRIPE_PRICE_STANDARD=price_standard_379_49
STRIPE_PRICE_MEGASTORE=price_megastore_9639_63

# Stripe Price IDs for One-Time Generation Packs
STRIPE_PRICE_PACK_STARTER=price_starter_pack_5
STRIPE_PRICE_PACK_GROWTH=price_growth_pack_15
STRIPE_PRICE_PACK_SCALE=price_scale_pack_40


# ------------------------------------------------------------------------------
# 5. OPTIONAL SERVICES & MONITORING
# ------------------------------------------------------------------------------

# Sentry DSN for production crash reporting and error tracking
# Example: https://xxxxxxxx@o12345.ingest.sentry.io/67890
SENTRY_DSN=

# Resend / SMTP configuration for email notifications and drip bot
RESEND_API_KEY=
OWNER_EMAIL=founder@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Allowed CORS Origins (comma-separated URLs)
# Default: https://kopykat.onrender.com,http://localhost:8000
ALLOWED_ORIGINS=https://kopykat.onrender.com,http://localhost:8000

# Base public application URL (used for constructing email links & webhooks)
BASE_URL=https://kopykat.onrender.com
