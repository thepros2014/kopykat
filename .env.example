# ── Required ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It's already in .gitignore.

# ── AI Engine (pick one — both are free to start) ─────────────────────────────
# Google Gemini: https://aistudio.google.com/app/apikey  (FREE — no credit card)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI: https://platform.openai.com/api-keys  (needs $5 credit to start)
# OPENAI_API_KEY=your_openai_api_key_here

# Which provider to use: "gemini" or "openai"
AI_PROVIDER=gemini

# ── Stripe (free to sign up — only charges % per transaction) ──────────────────
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create these products in Stripe Dashboard → Products, then paste Price IDs here:
# Basic plan  → $9/month
STRIPE_PRICE_BASIC=price_...
# Pro plan    → $29/month
STRIPE_PRICE_PRO=price_...
# Business    → $79/month
STRIPE_PRICE_BUSINESS=price_...
# Credit packs (one-time payments)
STRIPE_PRICE_PACK_STARTER=price_...   # $5  → 25,000 tokens
STRIPE_PRICE_PACK_GROWTH=price_...    # $15 → 100,000 tokens
STRIPE_PRICE_PACK_SCALE=price_...     # $40 → 300,000 tokens

# ── App settings ───────────────────────────────────────────────────────────────
# Your deployed URL (set automatically on Render/Railway)
APP_BASE_URL=https://snapcopy.onrender.com

# Comma-separated list of allowed frontend origins for CORS (never use *)
ALLOWED_ORIGINS=https://snapcopy.onrender.com

# Random secret for JWT tokens — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_this_with_a_long_random_string_at_least_32_chars

# Random secret for the /admin/revenue endpoint (only you know this)
ADMIN_SECRET=replace_this_with_another_random_secret

# ── Optional: Email reports to your inbox ────────────────────────────────────
# Your email for daily revenue reports
OWNER_EMAIL=your@email.com

# Gmail SMTP (use an App Password, not your main password)
# Setup: myaccount.google.com → Security → 2-Step → App passwords
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
