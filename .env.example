# ==============================================================================
# KOPYKAT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit your real .env file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED CORE SECURITY & AUTHENTICATION (MUST CONFIGURE IN PRODUCTION)
# ------------------------------------------------------------------------------

# Runtime mode. Use "production" or "staging" to enable fail-closed secret
# validation, trusted-host enforcement, HSTS, and disabled API documentation.
ENVIRONMENT=development

# Secret key used for signing JWT authentication tokens.
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Fernet symmetric encryption key for stored marketplace API credentials & BYOK keys.
# Generate a 32-byte base64 Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=replace_with_a_base64_fernet_key

# Master admin secret header (X-Admin-Secret) for inspecting revenue & health.
ADMIN_SECRET=replace_with_a_secure_admin_passphrase


# ------------------------------------------------------------------------------
# 2. REQUIRED DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

# PostgreSQL connection URI (Neon.tech, Supabase, or AWS RDS). Staging and
# production fail startup unless this is explicitly configured. In local
# development without Postgres, SQLite is used automatically.
# Example: postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/kopykat?sslmode=require
DATABASE_URL=sqlite:///./data/kopykat.db


# ------------------------------------------------------------------------------
# 3. AI ENGINE CONFIGURATION
# ------------------------------------------------------------------------------

# Preferred provider for content, campaign, and scheduled marketing jobs.
# Use "openai" or "gemini". The application falls back to the other
# configured provider for supported workflows.
AI_PROVIDER=openai

# OpenAI API key for text and vision generation. Keep this in the deployment
# secret manager or local .env only; never commit a real key.
OPENAI_API_KEY=

# OpenAI model used by the Responses API adapter.
OPENAI_MODEL=gpt-4o-mini

# Google AI Studio API key for Gemini content and vision generation.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default Gemini model name.
GEMINI_MODEL=gemini-flash-latest

# BYOK provider calls are paid directly to the customer's provider account.
# KopyKat still meters managed server activity separately so BYOK is not an
# unlimited claim against shared application infrastructure. These values are
# bounded by server/config.py and can be tuned for the deployed capacity.
BYOK_SERVER_ACTIVITY_LIMIT=2500
BYOK_SERVER_ACTIVITY_PERIOD_DAYS=30


# ------------------------------------------------------------------------------
# 4. STRIPE BILLING CONFIGURATION
# ------------------------------------------------------------------------------

# Stripe Secret API Key (begins with sk_live_... in prod or sk_test_... in dev)
STRIPE_SECRET_KEY=sk_test_51...

# Stripe Webhook Signing Secret (begins with whsec_...)
# Obtain from Stripe Dashboard -> Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for Subscription Tiers
# Create recurring monthly prices in Stripe Dashboard:
STRIPE_PRICE_BOUTIQUE=price_boutique_179_49
STRIPE_PRICE_STANDARD=price_standard_379_49
STRIPE_PRICE_MEGASTORE=price_megastore_9639_63

# Stripe Price IDs for One-Time Generation Packs
STRIPE_PRICE_PACK_STARTER=price_starter_pack_5
STRIPE_PRICE_PACK_GROWTH=price_growth_pack_15
STRIPE_PRICE_PACK_SCALE=price_scale_pack_40

# Featured front-page placement: five slots. Configure the private commercial
# schedule in Stripe; listings remain hidden until Stripe confirms payment.
STRIPE_PRICE_DROPSHIP_FEATURED_MONTHLY=price_dropship_featured_monthly
STRIPE_PRICE_DROPSHIP_FEATURED_ANNUAL=price_dropship_featured_annual

# Ranked dropshipping-tab placement: configure one annual Stripe price per
# private ranked slot. The server enforces the eight-slot ordering.
STRIPE_PRICE_DROPSHIP_DIRECTORY_SLOT_1_ANNUAL=price_dropship_directory_slot_1_annual
STRIPE_PRICE_DROPSHIP_DIRECTORY_SLOT_2_ANNUAL=price_dropship_directory_slot_2_annual
STRIPE_PRICE_DROPSHIP_DIRECTORY_SLOT_3_ANNUAL=price_dropship_directory_slot_3_annual
STRIPE_PRICE_DROPSHIP_DIRECTORY_SLOT_4_ANNUAL=price_dropship_directory_slot_4_annual
STRIPE_PRICE_DROPSHIP_DIRECTORY_SLOT_5_ANNUAL=price_dropship_directory_slot_5_annual
STRIPE_PRICE_DROPSHIP_DIRECTORY_SLOT_6_ANNUAL=price_dropship_directory_slot_6_annual
STRIPE_PRICE_DROPSHIP_DIRECTORY_SLOT_7_ANNUAL=price_dropship_directory_slot_7_annual
STRIPE_PRICE_DROPSHIP_DIRECTORY_SLOT_8_ANNUAL=price_dropship_directory_slot_8_annual


# ------------------------------------------------------------------------------
# 5. OPTIONAL SERVICES & MONITORING
# ------------------------------------------------------------------------------

# Sentry DSN for production crash reporting and error tracking
# Example: https://xxxxxxxx@o12345.ingest.sentry.io/67890
SENTRY_DSN=

# Resend / SMTP configuration for email notifications and drip bot
RESEND_API_KEY=
OWNER_EMAIL=founder@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# SMTP settings are optional; partner contacts below are private deployment
# configuration used only by the individual activation emailer.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DROPSHIP_PARTNER_PRINTFUL_EMAIL=
DROPSHIP_PARTNER_PRINTIFY_EMAIL=
DROPSHIP_PARTNER_CJ_EMAIL=
DROPSHIP_PARTNER_BIGBUY_EMAIL=
DROPSHIP_PARTNER_SPOCKET_EMAIL=

# Allowed CORS Origins (comma-separated URLs)
# Default: https://snapcopy-ai.onrender.com,http://localhost:8000
ALLOWED_ORIGINS=https://snapcopy-ai.onrender.com,http://localhost:8000

# Hostnames accepted by the HTTP server and proxy addresses allowed to supply
# forwarded headers. Add your custom production hostname explicitly.
ALLOWED_HOSTS=snapcopy-ai.onrender.com,localhost,127.0.0.1
TRUSTED_PROXIES=127.0.0.1
MAX_REQUEST_BYTES=20971520

# Optional API documentation. Keep disabled in production unless operators
# explicitly need the interactive docs.
ENABLE_API_DOCS=false

# Base public application URL (used for constructing email links & webhooks).
# APP_BASE_URL takes precedence; BASE_URL remains supported for compatibility.
APP_BASE_URL=https://snapcopy-ai.onrender.com
BASE_URL=https://snapcopy-ai.onrender.com

# =============================================================================
# AI JOB — SolPulse Signal Engine + Automagic Bounty Hunter
# =============================================================================

# GitHub API token — increases rate limit from 60 to 5,000 req/hr for signal engine
# Leave blank to use unauthenticated (60 req/hr, sufficient for small narrative lists)
GITHUB_TOKEN=

# Helius RPC API key — free tier available at https://www.helius.dev/
# Leave blank to use the public demo key (rate limited)
HELIUS_API_KEY=

# Superteam Earn agent API key — from your Superteam Earn developer settings
# Required for the bounty hunter. Leave blank to disable bounty scanning.
SUPERTEAM_API_KEY=

# Telegram push notifications for bounty hunter alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bounty hunter behaviour
BOUNTY_MIN_FIT_SCORE=7         # Minimum AI fit score (1-10) to consider a bounty
BOUNTY_PORTFOLIO_LINK=https://kopykat.io   # URL attached to submitted proposals
BOUNTY_AUTO_SUBMIT=false       # Set to true to enable AUTONOMOUS proposal submission
BOUNTY_MONITOR_SUBMIT=false  # Set to true for instant (no-AI) submission when a new bounty is found
